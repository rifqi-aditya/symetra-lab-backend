                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "MANUAL",
                      "SHOPEE"
                    ],
                    "example": "MANUAL"
                  },
                  "job_id": {
                    "type": "string",
                    "example": "0aedbcc9-64f5-40cf-8768-d32063195bba"
                  },
                  "machine_id": {
                    "type": "string",
                    "format": "uuid",
                    "example": "07f899c6-248b-44da-8f4d-7e329ea787de"
                  },
                  "filament_id": {
                    "type": "string",
                    "format": "uuid",
                    "example": "1e18b2b4-e0e7-4e4c-9995-22b192a94329"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pekerjaan selesai, filamen terpotong, jam mesin bertambah",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
